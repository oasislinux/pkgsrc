$NetBSD: patch-toolkit_moz.configure,v 1.12 2020/12/17 09:53:15 ryoon Exp $

--- toolkit/moz.configure.orig	2020-12-03 23:14:21.000000000 +0000
+++ toolkit/moz.configure
@@ -216,6 +216,15 @@ def enable_audiounit_rust(target):
 set_config("MOZ_AUDIOUNIT_RUST", True, when=enable_audiounit_rust)
 set_define("MOZ_AUDIOUNIT_RUST", True, when=enable_audiounit_rust)
 
+# sndio cubeb backend
+# ==============================================================
+option("--enable-sndio", env="MOZ_SNDIO",
+       default=target_is_openbsd,
+       help="Enable sndio audio backend.")
+
+set_config("MOZ_SNDIO", depends_if("--enable-sndio")(lambda _: True))
+set_define("MOZ_SNDIO", depends_if("--enable-sndio")(lambda _: True))
+
 # Javascript engine
 # ==============================================================
 include("../js/moz.configure")
